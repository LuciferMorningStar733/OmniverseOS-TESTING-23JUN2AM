    },
    {
      "name": "Quick Note",
      "short_name": "Note",
      "description": "Capture a thought",
      "url": "/?app=notes",
      "icons": [{ "src": "logo192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Chat",
      "short_name": "AI",
      "description": "Chat with Cortex AI",
      "url": "/?app=chat",
      "icons": [{ "src": "logo192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share",
