# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files\n\n# compiled output\ndist\ntmp\nout-tsc\n*.tsbuildinfo\n.expo\n.expo-shared\n\n# dependencies\nnode_modules\n\n# IDEs and editors\n/.idea\n.project\n.classpath\n.c9/\n*.launch\n.settings/\n*.sublime-workspace\n\n# IDE - VSCode\n.vscode/*\n!.vscode/settings.json\n!.vscode/tasks.json\n!.vscode/launch.json\n!.vscode/extensions.json\n\n# misc\n/.sass-cache\n/connect.lock\n/coverage\n/libpeerconnection.log\nnpm-debug.log\nyarn-error.log\ntestem.log\n/typings\n\n# System Files\n.DS_Store\nThumbs.db\n\n# Build artifacts\nbuild/\n*.tar.gz\n*.zip\n\n# Replit workspace files — never commit these\n.replit\n.replitignore\nreplit.md\n.agents/\nartifacts/\nlib/\nscripts/\nsrc/\npnpm-workspace.yaml\npnpm-lock.yaml\ntsconfig.base.json\ntsconfig.json\nattached_assets/\n.cache/\n.local/\n\n# Emergent AI tool files\n.emergent/\nmemory/\n.gitconfig\n\n# pnpm / npm overrides\n.npmrc\n